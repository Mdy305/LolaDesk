<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Lola Brain — LolaDesk</title><link rel="stylesheet" href="app.css"><link rel="stylesheet" href="ux-runtime.css"><style>body{background:#060706}.brain{max-width:1500px;margin:auto;padding:28px}.hero{display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center}.eyebrow{font-size:11px;letter-spacing:.16em;color:#ccff00}.hero h1{font-size:42px;margin:7px 0}.muted{color:#92958e}.presence{width:112px;height:112px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 45% 40%,#ecffae,#ccff00 28%,#638000 55%,#10140a 72%);box-shadow:0 0 70px rgba(204,255,0,.34);position:relative}.presence:after{content:'';position:absolute;inset:-10px;border:1px solid rgba(204,255,0,.35);border-radius:50%;animation:pulse 2.4s ease-in-out infinite}@keyframes pulse{50%{transform:scale(1.08);opacity:.35}}.command{margin:24px 0;padding:14px 16px;border:1px solid rgba(204,255,0,.22);border-radius:18px;background:rgba(204,255,0,.05);display:flex;gap:12px;align-items:center}.command input{flex:1;border:0;outline:0;background:transparent;color:#fff;font-size:18px}.command button{background:#ccff00;color:#070807;border-radius:12px;padding:12px 18px;font-weight:800}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.metric{padding:18px}.metric b{font-size:28px;display:block;margin-top:7px}.layout{display:grid;grid-template-columns:1.35fr .85fr;gap:14px;margin-top:14px}.panel{padding:19px}.priority,.result,.timeline{padding:14px 0;border-bottom:1px solid rgba(255,255,255,.07)}.priority{display:grid;grid-template-columns:10px 1fr auto;gap:12px}.dot{width:8px;height:8px;border-radius:50%;background:#ccff00;margin-top:7px}.actions{display:flex;gap:8px;flex-wrap:wrap}.actions a,.actions button{border:1px solid rgba(255,255,255,.12);padding:8px 10px;border-radius:10px;font-size:12px}.suggestions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.suggestions button{background:rgba(255,255,255,.06);padding:9px 11px;border-radius:999px;color:#bbb}.answer{margin-top:14px;padding:16px;border-radius:16px;background:#0e110c;min-height:90px;white-space:pre-wrap}.status{display:inline-flex;align-items:center;gap:7px;font-size:12px;color:#ccff00}.status i{width:7px;height:7px;border-radius:50%;background:#ccff00;box-shadow:0 0 10px #ccff00}@media(max-width:1000px){.metrics{grid-template-columns:1fr 1fr}.layout{grid-template-columns:1fr}}@media(max-width:600px){.brain{padding:18px}.hero h1{font-size:32px}.presence{width:76px;height:76px}.metrics{grid-template-columns:1fr}.command{align-items:stretch;flex-direction:column}}</style></head><body data-page="brain"><div class="app"><main class="main"><div class="brain"><section class="hero"><div><div class="eyebrow">LOLA BRAIN OS</div><h1>Run the salon by command.</h1><p class="muted">Ask, search, decide and act across operations, growth, bookings and clients without changing screens.</p><div class="status"><i></i><span id="brainStatus">Building live business context…</span></div></div><div class="presence"><strong>LOLA</strong></div></section><form class="command" id="commandForm"><span>⌘</span><input id="commandInput" autocomplete="off" placeholder="Try: What should I do first?" aria-label="Ask Lola"><button type="submit" data-ux-action>Ask Lola</button></form><div class="suggestions"><button data-command="What should I do first?">What should I do first?</button><button data-command="Show revenue at risk">Revenue at risk</button><button data-command="Who cancelled?">Who cancelled?</button><button data-command="Fill tomorrow">Fill tomorrow</button><button data-command="Show growth opportunities">Growth opportunities</button></div><section class="metrics"><div class="card metric"><span class="muted">OPEN PRIORITIES</span><b id="open">—</b></div><div class="card metric"><span class="muted">URGENT</span><b id="urgent">—</b></div><div class="card metric"><span class="muted">VALUE AT RISK</span><b id="risk">—</b></div><div class="card metric"><span class="muted">GROWTH OPPORTUNITIES</span><b id="growth">—</b></div></section><section class="layout"><div><div class="card panel"><h2>Lola answer</h2><div class="answer" id="answer">I am connecting operations, owner brief and growth intelligence now.</div></div><div class="card panel" style="margin-top:14px"><h2>Universal results</h2><div id="results"><p class="muted">Ask Lola to surface the most relevant records and actions.</p></div></div></div><aside><div class="card panel"><h2>Live priorities</h2><div id="priorities">Loading…</div></div><div class="card panel" style="margin-top:14px"><h2>Workspace</h2><div class="actions"><a href="operations-os.html">Operations</a><a href="growth-os.html">Growth</a><a href="bookings.html">Calendar</a><a href="clients.html">Clients</a><a href="inbox.html">Inbox</a><a href="revenue.html">Revenue</a></div></div></aside></section></div></main></div><script src="auth-guard.js"></script><script src="ux-runtime.js"></script><script src="sidebar.js"></script><script>const token=()=>localStorage.getItem('loladesk_token')||'';const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const usd=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(Number(n)||0);let context={ops:null,brief:null,growth:null};async function api(url){const r=await fetch(url,{headers:{Authorization:'Bearer '+token()}});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||url+' failed');return d}function render(){const o=context.ops||{metrics:{},tasks:[]},g=context.growth||{summary:{},segments:{}},b=context.brief||{priorities:[]};open.textContent=o.metrics.open_tasks??0;urgent.textContent=o.metrics.urgent??0;risk.textContent=usd(o.metrics.recoverable_revenue||0);growth.textContent=g.summary.opportunity_count??0;const items=(o.tasks||[]).slice(0,7);priorities.innerHTML=items.length?items.map(x=>`<div class="priority"><i class="dot"></i><div><b>${esc(x.title)}</b><div class="muted" style="font-size:12px">${esc(x.detail||'')}${x.value_at_risk?' · '+usd(x.value_at_risk)+' at risk':''}</div></div><a href="operations-os.html">Open</a></div>`).join(''):(b.priorities||[]).map(x=>`<div class="priority"><i class="dot"></i><div>${esc(x)}</div></div>`).join('')||'<p class="muted">No urgent work.</p>';brainStatus.textContent='Live context ready · '+new Date().toLocaleTimeString()}function answerCommand(q){const s=q.toLowerCase(),o=context.ops||{metrics:{},tasks:[]},g=context.growth||{summary:{},segments:{},campaigns:[]},b=context.brief||{priorities:[],today:{schedule:[]}};let text='',rows=[];if(s.includes('first')||s.includes('priority')){const top=(o.tasks||[])[0];text=top?`Your first priority is ${top.title}. ${top.detail||''}${top.value_at_risk?' It represents '+usd(top.value_at_risk)+' at risk.':''}`:'Operations are clear. Review growth opportunities next.';rows=(o.tasks||[]).slice(0,5)}else if(s.includes('risk')||s.includes('revenue')){text=`Lola currently identifies ${usd(o.metrics.recoverable_revenue||0)} in recoverable value across ${o.metrics.open_tasks||0} open operational tasks. Growth OS estimates ${usd(g.summary.estimated_recoverable_revenue||0)} in additional opportunity.`;rows=(o.tasks||[]).filter(x=>x.value_at_risk).slice(0,8)}else if(s.includes('cancel')){rows=(g.segments?.cancelled||[]).slice(0,20);text=`There are ${rows.length} currently eligible cancellation-recovery clients. Opted-out clients remain excluded.`}else if(s.includes('fill')||s.includes('tomorrow')){text=`Tomorrow-fill workflow is ready. Start with cancellation recovery and clients due for rebooking. Current eligible growth audience: ${g.summary.opportunity_count||0}.`;rows=[...(g.segments?.cancelled||[]),...(g.segments?.retention_due||[])].slice(0,20)}else if(s.includes('growth')||s.includes('opportun')){text=`Growth OS has ${g.summary.opportunity_count||0} eligible opportunities worth an estimated ${usd(g.summary.estimated_recoverable_revenue||0)}.`;rows=(g.campaigns||[]).slice(0,10)}else{text=`I found live context across operations, growth and today's owner brief. You have ${o.metrics.open_tasks||0} open tasks, ${o.metrics.urgent||0} urgent items and ${g.summary.opportunity_count||0} growth opportunities.`;rows=(o.tasks||[]).slice(0,6)}answer.textContent=text;results.innerHTML=rows.length?rows.map(x=>`<div class="result"><b>${esc(x.title||x.name||x.id||'Opportunity')}</b><div class="muted" style="font-size:12px">${esc(x.detail||x.description||x.phone||x.email||'')}${x.estimated_revenue?' · '+usd(x.estimated_revenue):''}</div><div class="actions" style="margin-top:8px"><a href="${x.client_id?'clients.html':'operations-os.html'}">Open</a><a href="growth-os.html">Growth action</a></div></div>`).join(''):'<p class="muted">No matching live records.</p>'}async function load(){[context.ops,context.brief,context.growth]=await Promise.all([api('/api/operations-os'),api('/api/owner-brief'),api('/api/growth-os')]);render();answerCommand('What should I do first?')}commandForm.onsubmit=e=>{e.preventDefault();answerCommand(commandInput.value.trim()||'What should I do first?')};document.querySelectorAll('[data-command]').forEach(b=>b.onclick=()=>{commandInput.value=b.dataset.command;answerCommand(b.dataset.command)});window.LolaAuth.ready.then(()=>LolaUX.run(load,{error:'Lola Brain could not build live context.'}));setInterval(()=>load().catch(()=>{}),45000);</script></body></html>